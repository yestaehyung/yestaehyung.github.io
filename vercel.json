{
  "redirects": [
    {
      "source": "/pado",
      "destination": "/coling25-pado/",
      "permanent": true
    },
    {
      "source": "/pado/:path*",
      "destination": "/coling25-pado/:path*",
      "permanent": true
    },
    {
      "source": "/lbw-mos",
      "destination": "/chi23-mos/",
      "permanent": true
    },
    {
      "source": "/lbw-mos/:path*",
      "destination": "/chi23-mos/:path*",
      "permanent": true
    },
    {
      "source": "/blog",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/blog/:path*",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/:path((?!.*\\.).*)",
      "destination": "/index.html"
    }
  ]
}
